<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!-- send-to-peer reads the peer table through pkexec. One read-only action,
     bound to a root-owned script. -->
<policyconfig>
  <vendor>yeetdrop</vendor>
  <action id="io.yeetdrop.peers">
    <description>List nearby AirDrop devices</description>
    <message>Authentication is required to list nearby AirDrop devices</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/yeetdrop/omdrop-discoverable</annotate>
  </action>
</policyconfig>
